# minisearch configuration template.
#
# Copy this file to `.env` and edit. The real `.env` is gitignored and must
# never be committed. Every value here has a safe default in minisearch/config.py;
# entries below exist to document what is tunable.

# --- Crawl safety rail -------------------------------------------------------
# Comma-separated hosts the crawler is ALLOWED to fetch. This is a hard allowlist:
# the fetcher refuses any host not listed here, so a test crawl can never wander
# onto a site you did not intend to hit. Empty = nothing may be crawled.
# The two defaults below are sites explicitly built for scraping practice.
ALLOWED_DOMAINS=books.toscrape.com,quotes.toscrape.com

# Identify the crawler honestly to the sites it visits.
USER_AGENT=minisearch-bot/0.1 (+https://github.com/SapnilPatel/minisearch)

# --- Fetcher pool (Milestone 3) ---------------------------------------------
FETCHER_WORKERS=8
REQUEST_TIMEOUT_S=10.0
MAX_PAGE_BYTES=5242880
MAX_RETRIES=3

# --- Frontier (Milestone 2) --------------------------------------------------
MAX_FRONTIER_SIZE=100000
PER_HOST_DELAY_S=1.0

# --- Store / Postgres (Milestone 6) -----------------------------------------
# Local Homebrew Postgres. Create the db with: createdb minisearch
DATABASE_URL=postgresql://localhost:5432/minisearch

# --- API (Milestone 8) -------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8080
